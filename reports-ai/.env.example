# مفتاح Anthropic API — من https://console.anthropic.com (يبقى على الخادم فقط)
ANTHROPIC_API_KEY=

# النموذج الافتراضي، ونموذج لكل مهمة (اختياري)
#   extract : استخراج الأرقام من التقارير (مرة واحدة لكل تقرير)
#   map     : توحيد أسماء المؤشرات بين السنوات
#   ask     : الإجابة عن الأسئلة
#   report  : تحرير التقارير الجديدة
#   repair  : تصحيح ترتيب «لا» في النص العربي المستخرج من بعض ملفات PDF (عند الحاجة فقط)
#   slides  : تحويل تقرير محرَّر إلى عرض PowerPoint
RAI_MODEL=claude-opus-5-5
RAI_MODEL_EXTRACT=claude-sonnet-5-5
RAI_MODEL_MAP=claude-sonnet-5-5
RAI_MODEL_ASK=claude-opus-5-5
RAI_MODEL_REPORT=claude-opus-5-5
RAI_MODEL_REPAIR=claude-haiku-5-5
RAI_MODEL_SLIDES=claude-sonnet-5-5

# نموذج محلي على حاسوبك (Ollama) بدل Claude — اختياري (انظر README: «نموذج محلي»)
#   RAI_PROVIDER=anthropic (افتراضي) أو local، لكل المهام أو لمهمة واحدة: RAI_PROVIDER_<المهمة>
# RAI_PROVIDER=anthropic
# RAI_PROVIDER_REPAIR=local
# RAI_PROVIDER_EXTRACT=local
# RAI_PROVIDER_MAP=local
#   عنوان Ollama أو البوابة (رابط القناة)، اسم النموذج (من ollama list)، ومفتاح البوابة
# RAI_LOCAL_URL=https://xxxx.trycloudflare.com
# RAI_LOCAL_MODEL=qwen3.5:4b
# RAI_LOCAL_MODEL_EXTRACT=qwen3.5:4b
# RAI_LOCAL_KEY=
#   المفتاح يُرسل كـ «Authorization: Bearer …»؛ أو في ترويسة أخرى، مثلاً X-API-Key
# RAI_LOCAL_KEY_HEADER=Authorization
#   حجم السياق (tokens)، مهلة الجواب (ثوانٍ)، ووضع التفكير (true/false، لنماذج Qwen 3 فقط)
# RAI_LOCAL_CONTEXT=16384
# RAI_LOCAL_TIMEOUT=900
# RAI_LOCAL_THINK=false

# خدمة قراءة الملفات على حاسوبك (extractor/) — عندما لا تتوفر pdftotext أو LibreOffice على الاستضافة
#   شغّل extractor/start-windows.bat على حاسوبك، وانسخ السطرين اللذين يظهران
# RAI_EXTRACT_URL=https://xxxx.trycloudflare.com
# RAI_EXTRACT_KEY=
#   auto (افتراضي): فقط إن لم تتوفر الأداة على الاستضافة — always: دائماً عبر حاسوبك
# RAI_EXTRACT_REMOTE=auto

# ملف إعدادات القطاع (اسم الإدارة، المصطلحات، الأصناف). الافتراضي: config/domain.php (التعمير)
# RAI_DOMAIN_FILE=config/domain.php

# الحجم الأقصى لملف PDF المرفوع (ميغابايت)
RAI_MAX_UPLOAD_MB=60
