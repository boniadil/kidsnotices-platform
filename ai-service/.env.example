# مفتاح Anthropic API — من https://console.anthropic.com (لا تضعه أبداً في كود الواجهة أو تطبيق أندرويد)
ANTHROPIC_API_KEY=sk-ant-...

# السر المشترك بين منصة KidsNotices وخدمة الذكاء الاصطناعي (ولّده بـ: php -r "echo bin2hex(random_bytes(32));")
KN_AI_SECRET=change-me

# النموذج المستعمل
KN_AI_MODEL=claude-opus-5-5

# الحد الأقصى لعدد الطلبات اليومية لكل مؤسسة (0 = بدون حد)
KN_AI_DAILY_LIMIT_PER_SCHOOL=500
