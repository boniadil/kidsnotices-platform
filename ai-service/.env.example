# مفتاح Anthropic API — من https://console.anthropic.com (لا تضعه أبداً في كود الواجهة أو تطبيق أندرويد)
ANTHROPIC_API_KEY=

# النموذج الافتراضي، ونموذج خاص بكل ميزة (اختياري)
KN_AI_MODEL=claude-opus-5-5
KN_AI_MODEL_PARENT_CHAT=claude-haiku-5-5
KN_AI_MODEL_SEARCH=claude-haiku-5-5
KN_AI_MODEL_TRANSLATE=claude-haiku-5-5
KN_AI_MODEL_DRAFT=claude-sonnet-5-5
KN_AI_MODEL_TEACHER=claude-sonnet-5-5
KN_AI_MODEL_INSIGHTS=claude-opus-5-5

# الحد الشهري لعدد الطلبات لكل مدرسة ولكل ميزة (0 = بدون حد)
KN_AI_MONTHLY_LIMIT_PARENT_CHAT=3000
KN_AI_MONTHLY_LIMIT_SEARCH=3000
KN_AI_MONTHLY_LIMIT_DRAFT=500
KN_AI_MONTHLY_LIMIT_TRANSLATE=1000
KN_AI_MONTHLY_LIMIT_TEACHER=1000
KN_AI_MONTHLY_LIMIT_INSIGHTS=100

# الحد اليومي لكل مستعمل نهائي (ولي أمر، أستاذ…) — كل الميزات مجتمعة (0 = بدون حد)
KN_AI_DAILY_LIMIT_PER_USER=30

# قاعدة البيانات (الاستهلاك، العملاء، الحدود). افتراضياً SQLite في storage/ — أو MySQL:
# KN_AI_DB_DSN=mysql:host=localhost;dbname=kn_ai;charset=utf8mb4
# KN_AI_DB_USER=
# KN_AI_DB_PASSWORD=

# كلمة سر لوحة الاستهلاك /dashboard (المستخدم: admin) — ولّدها بـ: php bin/kn-admin.php admin:password
KN_AI_ADMIN_PASSWORD_HASH=
